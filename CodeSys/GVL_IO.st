VAR_GLOBAL
	(* ===================== MODE AND COMMON ===================== *)
	I_ModeManual AT %IX0.0 : BOOL; (* Manual/Automatic selector switch: 1 = Manual, 0 = Automatic *)
	HMI_Auto_Start : BOOL; (* HMI request to enable automatic sequence when in automatic mode *)
	HMI_ResetFaults : BOOL; (* HMI command to reset latched emergency conditions *)

	(* ===================== HMI MANUAL COMMANDS ===================== *)
	HMI_Fan1_Start : BOOL; (* Manual start for Local Fan 1 *)
	HMI_Fan2_Start : BOOL; (* Manual start for Local Fan 2 *)
	HMI_Fan3_Start : BOOL; (* Manual start for Local Fan 3 *)
	HMI_Fan4_Start : BOOL; (* Manual start for Local Fan 4 *)
	HMI_Fan5_Start : BOOL; (* Manual start for Local Fan 5 *)
	HMI_TransportFan_Start : BOOL; (* Manual start for Transport Fan *)
	HMI_Screw_Start : BOOL; (* Manual start for Screw Conveyor *)
	HMI_Vibrator1_Start : BOOL; (* Manual start for Vibrator 1 *)
	HMI_Vibrator2_Start : BOOL; (* Manual start for Vibrator 2 *)
	HMI_Hydraulic_Open : BOOL; (* Manual open command for Hydraulic Hatch *)
	HMI_Hydraulic_Close : BOOL; (* Manual close command for Hydraulic Hatch *)

	(* ===================== PHYSICAL INPUTS (FAULTS, LIMITS) ===================== *)
	(* VFD Faults for Local Fans *)
	I_Fan1_VFD_Fault AT %IX1.0 : BOOL; (* VFD fault for Local Fan 1 *)
	I_Fan2_VFD_Fault AT %IX1.1 : BOOL; (* VFD fault for Local Fan 2 *)
	I_Fan3_VFD_Fault AT %IX1.2 : BOOL; (* VFD fault for Local Fan 3 *)
	I_Fan4_VFD_Fault AT %IX1.3 : BOOL; (* VFD fault for Local Fan 4 *)
	I_Fan5_VFD_Fault AT %IX1.4 : BOOL; (* VFD fault for Local Fan 5 *)

	(* VFD Faults for other mechanisms — keep within byte 1 for example mapping *)
	I_TransportFan_VFD_Fault AT %IX1.5 : BOOL; (* VFD fault for Transport Fan *)
	I_Screw_VFD_Fault AT %IX1.6 : BOOL; (* VFD fault for Screw Conveyor *)
	I_Vibrator1_VFD_Fault AT %IX1.7 : BOOL; (* VFD fault for Vibrator 1 (if applicable) *)
	I_Vibrator2_VFD_Fault AT %IX3.0 : BOOL; (* VFD fault for Vibrator 2 (if applicable); mapped to input byte 3 bit 0 *)

	(* Circuit breaker trips (as per requirement: only vibrators and hydraulic motor) *)
	I_Vibrator1_CB_Trip AT %IX2.0 : BOOL; (* Circuit breaker trip for Vibrator 1 *)
	I_Vibrator2_CB_Trip AT %IX2.1 : BOOL; (* Circuit breaker trip for Vibrator 2 *)
	I_Hydraulic_CB_Trip AT %IX2.2 : BOOL; (* Circuit breaker trip for Hydraulic Power Unit/Motor *)

	(* Hydraulic hatch limit switches *)
	I_Hatch_Open_LS AT %IX2.3 : BOOL; (* Hydraulic Hatch OPEN position limit switch *)
	I_Hatch_Closed_LS AT %IX2.4 : BOOL; (* Hydraulic Hatch CLOSED position limit switch *)

	(* ===================== PHYSICAL OUTPUTS (COMMANDS) ===================== *)
	Q_Fan1_Run AT %QX0.0 : BOOL; (* Run command for Local Fan 1 *)
	Q_Fan2_Run AT %QX0.1 : BOOL; (* Run command for Local Fan 2 *)
	Q_Fan3_Run AT %QX0.2 : BOOL; (* Run command for Local Fan 3 *)
	Q_Fan4_Run AT %QX0.3 : BOOL; (* Run command for Local Fan 4 *)
	Q_Fan5_Run AT %QX0.4 : BOOL; (* Run command for Local Fan 5 *)
	Q_TransportFan_Run AT %QX0.5 : BOOL; (* Run command for Transport Fan *)
	Q_Screw_Run AT %QX0.6 : BOOL; (* Run command for Screw Conveyor *)
	Q_Vibrator1_Run AT %QX1.0 : BOOL; (* Run command for Vibrator 1 *)
	Q_Vibrator2_Run AT %QX1.1 : BOOL; (* Run command for Vibrator 2 *)
	Q_Hydraulic_Open AT %QX1.2 : BOOL; (* Open command for Hydraulic Hatch actuator *)
	Q_Hydraulic_Close AT %QX1.3 : BOOL; (* Close command for Hydraulic Hatch actuator *)

	(* ===================== STATUS / DIAGNOSTICS FOR HMI ===================== *)
	Status_ModeManual : BOOL; (* Current mode: TRUE = Manual, FALSE = Automatic *)
	Status_AutoEnabled : BOOL; (* Auto sequence enable status *)
	Status_EmergencyActive : BOOL; (* Emergency latch active *)

	Status_Fan1_Running : BOOL; (* Status of Local Fan 1 command *)
	Status_Fan2_Running : BOOL; (* Status of Local Fan 2 command *)
	Status_Fan3_Running : BOOL; (* Status of Local Fan 3 command *)
	Status_Fan4_Running : BOOL; (* Status of Local Fan 4 command *)
	Status_Fan5_Running : BOOL; (* Status of Local Fan 5 command *)
	Status_TransportFan_Running : BOOL; (* Status of Transport Fan command *)
	Status_Screw_Running : BOOL; (* Status of Screw Conveyor command *)
	Status_Vibrator1_Running : BOOL; (* Status of Vibrator 1 command *)
	Status_Vibrator2_Running : BOOL; (* Status of Vibrator 2 command *)
	Status_Hydraulic_Busy : BOOL; (* Hydraulic Hatch actuator active (open or close) *)
END_VAR